<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Возврат из браузера после входа через Яндекс ID.
                 Страница внутри приложения живёт по адресу localhost, и такого
                 адреса возврата у Яндекса нет — он отвечал ошибкой 400. Поэтому
                 адрес возврата теперь ru.heatcalc.app://oauth: браузер по нему
                 будит приложение, и код авторизации попадает прямо сюда.
                 Тот же адрес должен быть прописан в настройках приложения
                 на oauth.yandex.ru как Callback URL. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Состояние сети. Само по себе приложение его не спрашивает, но без этой
         строки встроенный браузер отвечает на вопрос «есть ли интернет?»
         (navigator.onLine) всегда «нет» — независимо от того, что происходит
         на самом деле. Из-за этого приложение с рабочей связью показывало
         плашку «Нет сети», а сообщения об ошибках сваливались на «нет связи
         с сервером», пряча настоящую причину. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Показ уведомлений. Начиная с Android 13 разрешение спрашивается у человека,
         и без этой строки система отклоняет запрос молча — окна с вопросом он не
         увидит вообще. Плагин push-notifications её не приносит: в его манифесте
         объявлена только служба приёма сообщений. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Съёмка сметы и плана этажа прямо в приложении. Разрешение спрашивает
         сам Capacitor, когда человек нажимает «Сфотографировать»: без строки
         ниже система отклоняет запрос молча. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Обязательная пара к разрешению выше. Иначе Android считает камеру
         необходимой, и магазин прячет приложение от планшетов без задней
         камеры — а считать смету на них можно и без съёмки. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
